# Copy to .env for local development. In the Cloud Agent these are injected as secrets.

# Atlas cluster connection string (source of truth)
MongoDB_URI_ALL=mongodb+srv://user:pass@cluster.mongodb.net/

# VoyageAI API key (embeddings)
VoyageAI_API_ALL=your-voyage-key

# Grove gateway key (gpt-5.5)
GROVE_LLM_KEY_ALL=your-grove-key

# Optional overrides
DB_NAME=patient_portal
LLM_MODEL=gpt-5.5
VOYAGE_MODEL=voyage-4
GROVE_URL=https://grove-gateway-prod.azure-api.net/grove-foundry-prod/openai/v1/responses
VOYAGE_URL=https://ai.mongodb.com/v1/embeddings

# Atlas Stream Processing (Phase 4) — SPI connection string (same DB user as MongoDB_URI_ALL)
ASP_URI=mongodb://user:pass@atlas-stream-xxxx.query.mongodb.net/?ssl=true&authSource=admin
ASP_CONNECTION_NAME=fhirCluster
